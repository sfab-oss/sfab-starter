{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 4011",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "test": "pnpm i18n:compile && vitest run --project node --project workers",
    "test:watch": "pnpm i18n:compile && vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types && wrangler types ../../packages/env/src/env.d.ts --include-runtime=false && node ../../packages/env/scripts/postprocess-env.mjs",
    "generate-routes": "tsr generate",
    "i18n:compile": "paraglide-js compile --project ../../packages/i18n/project.inlang --outdir ./src/paraglide --strategy cookie baseLocale --output-structure message-modules --emit-ts-declarations",
    "typecheck": "pnpm i18n:compile && tsc --noEmit",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "db:list": "wrangler d1 migrations list DB --local",
    "db:studio": "pnpm --filter @workspace/db db:studio"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.45",
    "@ai-sdk/openai": "4.0.43",
    "@ai-sdk/react": "4.0.71",
    "@cloudflare/shell": "0.4.3",
    "@cloudflare/think": "0.16.0",
    "@cloudflare/vite-plugin": "1.43.0",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.47",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-cli": "1.167.31",
    "@tanstack/router-plugin": "1.168.33",
    "@workspace/agent": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/contract": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/log": "workspace:*",
    "@workspace/ui": "workspace:*",
    "agents": "0.21.0",
    "ai": "7.0.68",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "hono": "^4.12.28",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.2",
    "use-debounce": "^10.1.1",
    "zod": "4.3.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@inlang/paraglide-js": "2.21.0",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "@workspace/tsconfig": "workspace:*",
    "better-auth": "1.6.19",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "wrangler": "4.107.0"
  }
}
